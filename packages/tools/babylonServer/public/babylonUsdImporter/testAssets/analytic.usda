#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Cube"
    {
        double size = 1.4
        color3f[] primvars:displayColor = [(0.2, 0.55, 0.95)]
        double3 xformOp:translate = (-3, 0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Sphere"
    {
        uniform token orientation = "leftHanded"
        double radius = 0.8
        color3f[] primvars:displayColor = [(0.95, 0.35, 0.3)]
        double3 xformOp:translate = (-1, 0.8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cylinder"
    {
        uniform token axis = "Z"
        double height = 2
        double radius = 0.65
        color3f[] primvars:displayColor = [(0.25, 0.8, 0.45)]
        double3 xformOp:translate = (1, 0.8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "Cone"
    {
        uniform token axis = "X"
        double height = 2
        double radius = 0.8
        color3f[] primvars:displayColor = [(0.85, 0.65, 0.2)]
        double3 xformOp:translate = (3, 0.8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
