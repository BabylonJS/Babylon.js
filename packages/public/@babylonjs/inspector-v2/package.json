{
    "name": "@babylonjs/inspector",
    "version": "9.30.0",
    "main": "lib/index.js",
    "module": "lib/index.js",
    "esnext": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./lite": {
            "types": "./lib/lite/index.d.ts",
            "default": "./lib/lite/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "babylon-inspector": "./bin/inspector-cli.mjs"
    },
    "files": [
        "bin/**/*.mjs",
        "lib/**/*.js",
        "lib/**/*.d.ts",
        "lib/**/*.map",
        "readme.md",
        "license.md"
    ],
    "scripts": {
        "build": "npm run clean && npm run bundle",
        "clean": "rimraf lib && rimraf bin && rimraf dist && rimraf *.tsbuildinfo -g",
        "bundle": "npm run bundle:lib && npm run bundle:cli",
        "bundle:lib": "rollup -c rollup.config.lib.mjs && tsc -p tsconfig.build.dts.json && build-tools -c tp --outDir ./lib --buildType es6 --basePackage @babylonjs/inspector --appendJS",
        "bundle:cli": "rollup -c rollup.config.cli.mjs",
        "pack": "npm run build && npm pack"
    },
    "peerDependencies": {
        "@babylonjs/addons": "^9.0.0",
        "@babylonjs/core": "^9.0.0",
        "@babylonjs/gui": "^9.0.0",
        "@babylonjs/gui-editor": "^9.0.0",
        "@babylonjs/lite": "^1.32.0",
        "@babylonjs/loaders": "^9.0.0",
        "@babylonjs/materials": "^9.0.0",
        "@babylonjs/node-editor": "^9.0.0",
        "@babylonjs/node-geometry-editor": "^9.0.0",
        "@babylonjs/node-particle-editor": "^9.0.0",
        "@babylonjs/node-render-graph-editor": "^9.0.0",
        "@babylonjs/serializers": "^9.0.0",
        "@fluentui-contrib/react-resize-handle": "^0.8.4",
        "@fluentui-contrib/react-virtualizer": "^1.0.0",
        "@fluentui/react-components": "^9.70.0",
        "@fluentui/react-icons": "^2.0.310",
        "@fluentui/react-motion-components-preview": "^0.15.2",
        "@fluentui/react-utilities": "^9.26.2",
        "react": ">=16.14.0 <20.0.0",
        "react-dom": ">=16.14.0 <20.0.0",
        "usehooks-ts": "^3.1.1"
    },
    "peerDependenciesMeta": {
        "@babylonjs/lite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@babylonjs/lite": "1.32.0",
        "@dev/build-tools": "^1.0.0",
        "@dev/inspector": "1.0.0",
        "@rollup/plugin-alias": "^6.0.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/ws": "^8.18.1",
        "chalk": "^6.0.1",
        "rollup": "^4.63.4",
        "rollup-plugin-dts": "^6.5.1",
        "ws": "^8.21.3"
    },
    "keywords": [
        "3D",
        "javascript",
        "html5",
        "webgl",
        "babylon.js",
        "inspector",
        "diagnostic",
        "debug"
    ],
    "license": "Apache-2.0",
    "homepage": "https://www.babylonjs.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/BabylonJS/Babylon.js.git"
    },
    "bugs": {
        "url": "https://github.com/BabylonJS/Babylon.js/issues"
    }
}