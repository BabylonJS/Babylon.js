        "@babylonjs/core": "^9.0.0",
        "babylonjs-gltf2interface": "^9.0.0"
    },
    "keywords": [
        "3D",
        "javascript",
        "html5",
        "webgl",
        "babylon.js"
    ],
    "license": "Apache-2.0",
    "esnext": "index.js",
    "type": "module",
