{
    "name": "@babylonjs/loaders",
    "version": "9.19.1",
    "main": "index.js",
    "module": "index.js",
    "types": "index.d.ts",
    "files": [
        "**/*.js",
        "**/*.d.ts",
        "**/*.map",
        "readme.md",
        "license.md"
    ],
    "scripts": {
        "build": "npm run clean && npm run compile",
        "clean": "rimraf dist && rimraf *.tsbuildinfo -g && rimraf \"./**/*.!(md|json|build.json)\" -g",
        "compile": "tsc -b tsconfig.build.json && build-tools -c tp --outDir . --buildType es6 --basePackage @babylonjs/loaders --appendJS",
        "postcompile": "build-tools -c add-js-to-es6"
    },
    "devDependencies": {
        "@babylonjs/core": "9.19.1",
        "@dev/build-tools": "^1.0.0",
        "@dev/loaders": "^1.0.0",
        "babylonjs-gltf2interface": "9.19.1"
    },
