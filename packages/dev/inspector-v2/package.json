{
    "name": "@dev/inspector",
    "version": "1.0.0",
    "types": "dist/index",
    "main": "dist/index",
    "module": "dist/index",
    "private": true,
    "sideEffects": true,
    "scripts": {
        "build": "npm run clean && npm run compile",
        "test": "vitest run",
        "clean": "rimraf dist && rimraf *.tsbuildinfo -g",
        "compile": "tsc -b tsconfig.build.json",
        "serve": "vite",
        "watch": "tsc -b tsconfig.build.json -w",
        "watch:dev": "npm run watch",
        "makeAvatar": "node scripts/makeAvatar.mjs",
        "babylon-inspector": "node --no-warnings dist/cli/cli.js --bridge-script dist/cli/bridge.js"
    },
    "devDependencies": {
        "@babylonjs/lite": "1.38.1",
        "@dev/addons": "1.0.0",
        "@dev/core": "1.0.0",
        "@dev/gui": "1.0.0",
        "@dev/loaders": "1.0.0",
        "@dev/materials": "1.0.0",
        "@dev/serializers": "1.0.0",
        "@fluentui-contrib/react-resize-handle": "^0.8.4",
        "@fluentui-contrib/react-virtualizer": "^1.0.0",
        "@fluentui/react-charts": "9.3.29",
        "@fluentui/react-components": "^9.74.11",
        "@fluentui/react-icons": "^2.0.344",
        "@fluentui/react-motion-components-preview": "^0.15.10",
        "@tools/gui-editor": "1.0.0",
        "@tools/node-editor": "1.0.0",
        "@tools/node-geometry-editor": "1.0.0",
        "@tools/node-particle-editor": "1.0.0",
        "@tools/node-render-graph-editor": "1.0.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/ws": "^8.18.2",
        "fflate": "^0.8.3",
        "gif.js.optimized": "^1.0.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sharp": "^0.35.4",
        "ws": "^8.22.0"
    },
    "dependencies": {
        "@babylonjs/havok": "^1.3.14"
    }
}
