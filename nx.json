{
    "defaultBase": "master",
    "plugins": ["./scripts/nxCleanCache.mjs"],
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "buildTools"],
        "buildTools": [
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/package-lock.json",
            "{workspaceRoot}/tsconfig*.json",
            "{workspaceRoot}/packages/public/*.mjs",
            "{workspaceRoot}/packages/tools/rollup.config.mcp.mjs",
            "{workspaceRoot}/scripts/**/*",
            "{workspaceRoot}/packages/tools/babylonServer/public/**/*",
            { "env": "NODE_ENV" },
            { "env": "ROLLUP_MODE" },
            { "env": "ROLLUP_DEVMODE" },
            { "runtime": "node --version" }
        ]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build", "clean-for-cache"],
            "cache": true,
            "inputs": ["default", "^default"],
            "outputs": [
                "{projectRoot}/dist",
                "{projectRoot}/lib",
                "{projectRoot}/bin",
                "{projectRoot}/assets",
                "{projectRoot}/wasm",
                "{projectRoot}/**/*.js",
                "{projectRoot}/**/*.map",
                "{projectRoot}/**/*.d.ts",
                "{projectRoot}/*.tsbuildinfo",
                "{projectRoot}/src/**/[Ss]haders*/**/*.ts",
                "{projectRoot}/src/**/*.fragment.ts",
                "{projectRoot}/src/**/*.vertex.ts",
                "{projectRoot}/src/**/*.compute.ts"
            ]
        },
        "prepare": {
            "dependsOn": ["^prepare"]
        },
        "package": {
            "dependsOn": ["^package"]
        }
    },
    "analytics": false
}
